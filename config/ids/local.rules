# Local rules for the enterprise-network-lab sensor.
#
# These are deliberately simple and readable — the point is that a student
# can open this file, understand every rule, and add their own. The
# Emerging Threats Open ruleset is also loaded for real-world coverage.
#
# Local SIDs use the 9000000+ range, which is reserved for site-local rules.

# ── Reconnaissance ────────────────────────────────────────────────────
alert tcp any any -> $HOME_NET any (msg:"LAB Possible TCP port scan (SYN to many ports)"; \
    flags:S; threshold:type both, track by_src, count 25, seconds 10; \
    classtype:attempted-recon; sid:9000001; rev:1;)

alert icmp any any -> $HOME_NET any (msg:"LAB ICMP sweep (many hosts pinged quickly)"; \
    itype:8; threshold:type both, track by_src, count 15, seconds 10; \
    classtype:attempted-recon; sid:9000002; rev:1;)

# ── Suspicious access to the intranet ─────────────────────────────────
alert http any any -> 10.10.20.80 any (msg:"LAB Scanner user-agent hitting the intranet"; \
    http.user_agent; content:"Nmap"; nocase; \
    classtype:web-application-attack; sid:9000003; rev:1;)

alert http any any -> 10.10.20.80 any (msg:"LAB Intranet admin path probed"; \
    http.uri; content:"/admin"; nocase; \
    classtype:web-application-activity; sid:9000004; rev:1;)

# ── Data exfiltration signals ─────────────────────────────────────────
# DNS tunnelling shows up as unusually long labels in query names.
alert dns any any -> any 53 (msg:"LAB Suspiciously long DNS query (possible tunnelling)"; \
    dns.query; content:!"corp.lab"; pcre:"/^[a-zA-Z0-9\-]{40,}\./"; \
    classtype:policy-violation; sid:9000005; rev:1;)

# Beaconing: the same host talking to the same port at a steady rate.
alert tcp $HOME_NET any -> any 4444 (msg:"LAB Connection to common C2 port 4444"; \
    flow:to_server; classtype:trojan-activity; sid:9000006; rev:1;)

# ── Policy ────────────────────────────────────────────────────────────
# Cleartext credentials crossing the WAN is a finding in its own right.
alert http any any -> $HOME_NET any (msg:"LAB Credentials posted over cleartext HTTP"; \
    http.method; content:"POST"; http.request_body; content:"password="; nocase; \
    classtype:policy-violation; sid:9000007; rev:1;)
